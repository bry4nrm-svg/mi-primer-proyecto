# HTTPS automatico (Let's Encrypt). Solo apunta los 3 subdominios a la IP del VPS.

{$N8N_DOMAIN} {
	reverse_proxy n8n:5678
}

{$EVOLUTION_DOMAIN} {
	reverse_proxy evolution:8080
}

# Panel para tus clientes: https://panel.tudominio.com
{$PANEL_DOMAIN} {
	handle /webhook/panel-api {
		reverse_proxy n8n:5678
	}
	handle {
		root * /srv/panel
		file_server
	}
}
